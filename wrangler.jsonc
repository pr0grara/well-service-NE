{
  "name": "pinestate-well-and-pump",
  "compatibility_date": "2025-01-01",
  "main": "worker/index.js",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "404-page" },
  "r2_buckets": [ { "binding": "LEAD_FILES", "bucket_name": "arabuilds-lead-files" } ],
  "vars": {
    "SITE_SLUG": "well-repair-NE",
    "COMPANY": "Pine State Well & Pump",
    "ALERT_TO": "azbaghda@gmail.com",
    "ALERT_FROM": "Pine State Well & Pump <onboarding@resend.dev>"
  }
}
